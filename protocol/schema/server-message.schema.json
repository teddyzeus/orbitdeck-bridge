{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orbitdeck/server-message.schema.json",
  "title": "Message serveur → client (protocole OrbitDeck v1)",
  "type": "object",
  "required": ["v", "type"],
  "properties": {
    "v": { "const": 1 },
    "type": { "enum": ["hello", "state", "ack", "error", "pong"] }
  },
  "oneOf": [
    {
      "title": "hello",
      "properties": {
        "type": { "const": "hello" },
        "mod": { "type": "string" },
        "game": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["v", "type", "mod", "game"]
    },
    {
      "title": "state",
      "properties": {
        "type": { "const": "state" },
        "seq": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["connected", "noVessel", "notControllable"] },
        "gameState": { "type": ["string", "null"] },
        "vessel": {
          "type": "object",
          "properties": { "name": { "type": ["string", "null"] } }
        },
        "altitude": {
          "type": "object",
          "properties": {
            "seaLevel": { "type": ["number", "null"] },
            "surface": { "type": ["number", "null"] }
          }
        },
        "speed": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["surface", "orbit", "target"] },
            "surface": { "type": ["number", "null"] },
            "orbital": { "type": ["number", "null"] },
            "target": { "type": ["number", "null"] }
          }
        },
        "throttle": { "type": "number", "minimum": 0, "maximum": 1 },
        "sas": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": ["string", "null"] },
            "available": {
              "type": "array",
              "items": { "enum": ["stabilityAssist", "prograde", "retrograde", "normal", "antinormal", "radialIn", "radialOut", "target", "antiTarget", "maneuver"] }
            }
          }
        },
        "rcs": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "lights": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "brakes": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "gear": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "view": { "enum": ["ship", "map"] },
        "time": {
          "type": "object",
          "required": ["ut", "rate", "index", "rates", "mode", "paused"],
          "properties": {
            "ut": { "type": "number" },
            "rate": { "type": "number", "exclusiveMinimum": 0 },
            "index": { "type": "integer", "minimum": 0 },
            "rates": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
            "mode": { "enum": ["rails", "physics"] },
            "paused": { "type": "boolean" },
            "pausable": { "type": "boolean" },
            "maxIndex": { "type": "integer", "minimum": 0 },
            "limit": { "enum": ["atmosphere", "altitude", "thrust", "ground", "proximity", "other"] },
            "auto": { "type": "boolean" },
            "day": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "maneuver": {
          "type": "object",
          "required": ["count", "nodes"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "nodes": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["ut", "dv"],
                "properties": {
                  "ut": { "type": "number" },
                  "dv": { "type": "number", "minimum": 0 },
                  "burn": { "type": "number", "minimum": 0 },
                  "ignition": { "type": "number" },
                  "after": { "type": "object", "properties": { "ap": { "type": "number" }, "pe": { "type": "number" }, "escape": { "type": "boolean" }, "atmosphere": { "type": "number", "minimum": 0 } } }
                }
              }
            },
            "before": { "type": "object", "properties": { "ap": { "type": "number" }, "pe": { "type": "number" }, "escape": { "type": "boolean" }, "atmosphere": { "type": "number", "minimum": 0 } } },
            "dvAvailable": { "type": "number", "minimum": 0 },
            "burning": {
              "type": "object",
              "properties": { "remaining": { "type": "number", "minimum": 0 }, "progress": { "type": "number", "minimum": 0, "maximum": 1 } }
            },
            "warp": {
              "type": "object",
              "required": ["state"],
              "properties": {
                "state": { "enum": ["running", "arrived", "late", "interrupted"] },
                "stop": { "type": "number" },
                "reason": { "enum": ["manual", "nodeGone", "vessel", "control"] }
              }
            }
          }
        },
        "stage": {
          "type": "object",
          "properties": { "count": { "type": "integer", "minimum": 0 }, "exhausted": { "type": "boolean" } }
        },
        "orbit": {
          "type": "object",
          "properties": { "ap": { "type": "number" }, "pe": { "type": "number" }, "period": { "type": "number", "minimum": 0 }, "inc": { "type": "number" }, "apUt": { "type": "number" }, "peUt": { "type": "number" }, "body": { "type": "string" }, "escape": { "type": "boolean" }, "atmosphere": { "type": "number", "minimum": 0 } }
        },
        "resources": {
          "type": "object",
          "properties": {
            "fuel": { "type": "object", "required": ["amount", "max"], "properties": { "amount": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } }, "oxidizer": { "type": "object", "required": ["amount", "max"], "properties": { "amount": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } }, "electric": { "type": "object", "required": ["amount", "max"], "properties": { "amount": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } }, "monoprop": { "type": "object", "required": ["amount", "max"], "properties": { "amount": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } },
            "stage": { "type": "object", "properties": { "fuel": { "type": "object", "required": ["amount", "max"], "properties": { "amount": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } }, "oxidizer": { "type": "object", "required": ["amount", "max"], "properties": { "amount": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } }, "electric": { "type": "object", "required": ["amount", "max"], "properties": { "amount": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } }, "monoprop": { "type": "object", "required": ["amount", "max"], "properties": { "amount": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } } } }
          }
        },
        "performance": {
          "type": "object",
          "properties": { "dv": { "type": "number", "minimum": 0 }, "dvStage": { "type": "number", "minimum": 0 }, "twr": { "type": "number", "minimum": 0 } }
        },
        "landing": {
          "type": "object",
          "properties": { "vspeed": { "type": "number" }, "hspeed": { "type": "number" }, "radar": { "type": "number" }, "impactUt": { "type": "number" } }
        },
        "target": {
          "type": "object",
          "properties": { "none": { "type": "boolean" }, "name": { "type": "string" }, "distance": { "type": "number", "minimum": 0 }, "rel": { "type": "number" } }
        },
        "systems": {
          "type": "object",
          "properties": { "solar": { "type": "object", "required": ["count"], "properties": { "count": { "type": "integer", "minimum": 0 }, "state": { "enum": ["extended", "retracted", "mixed", "moving"] }, "retractable": { "type": "boolean" } } }, "antennas": { "type": "object", "required": ["count"], "properties": { "count": { "type": "integer", "minimum": 0 }, "state": { "enum": ["extended", "retracted", "mixed", "moving"] }, "retractable": { "type": "boolean" } } }, "ladders": { "type": "object", "required": ["count"], "properties": { "count": { "type": "integer", "minimum": 0 }, "state": { "enum": ["extended", "retracted", "mixed", "moving"] }, "retractable": { "type": "boolean" } } }, "parachutes": { "type": "object", "required": ["count"], "properties": { "count": { "type": "integer", "minimum": 0 }, "state": { "enum": ["ready", "deployed", "cut", "mixed"] }, "retractable": { "type": "boolean" } } } }
        },
        "docking": {
          "type": "object",
          "required": ["ports"],
          "properties": { "ports": { "type": "integer", "minimum": 0 }, "state": { "enum": ["disarmed", "armed", "approach", "docked"] }, "armable": { "type": "boolean" }, "canUndock": { "type": "boolean" } }
        }
      },
      "required": ["v", "type", "seq", "status"]
    },
    {
      "title": "ack",
      "properties": {
        "type": { "const": "ack" },
        "id": { "type": "string" }
      },
      "required": ["v", "type", "id"]
    },
    {
      "title": "error",
      "properties": {
        "type": { "const": "error" },
        "id": { "type": "string" },
        "code": { "enum": ["BAD_REQUEST", "UNKNOWN_COMMAND", "NO_VESSEL", "NOT_CONTROLLABLE", "REJECTED_BY_GAME", "INTERNAL"] },
        "message": { "type": "string" }
      },
      "required": ["v", "type", "code", "message"]
    },
    {
      "title": "pong",
      "properties": { "type": { "const": "pong" } },
      "required": ["v", "type"]
    }
  ]
}
